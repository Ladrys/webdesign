<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
  <xsl:output method="text" encoding="UTF-8"/>
  <xsl:key name="venueById" match="hala" use="@id"/>
  <xsl:key name="performerById" match="interpret" use="@id"/>
  <xsl:template match="/festival">{"items":[<xsl:for-each select="sumakce/akce">{"id":"<xsl:value-of select="@id"/>","name":"<xsl:value-of select="nazev"/>","theme":"<xsl:value-of select="tema_akce"/>","description":"<xsl:choose><xsl:when test="normalize-space(popis_akce)!=''"><xsl:value-of select="popis_akce"/></xsl:when><xsl:otherwise>Bez popisu akce.</xsl:otherwise></xsl:choose>","date":"<xsl:value-of select="datumstart"/>","startTime":"<xsl:value-of select="casstart"/>","endTime":"<xsl:value-of select="caskonec"/>","highlight":<xsl:choose><xsl:when test="hlavni_vystoupeni='true' or hlavni_vystoupeni='1'">true</xsl:when><xsl:otherwise>false</xsl:otherwise></xsl:choose>,"dayId":"<xsl:value-of select="den_ref"/>","venueId":"<xsl:value-of select="hala_ref"/>","venueName":"<xsl:value-of select="key('venueById', hala_ref)/nazev"/>","performerIds":[<xsl:for-each select="interpreti/interpret_ref">"<xsl:value-of select="."/>"<xsl:if test="position()!=last()">,</xsl:if></xsl:for-each>],"performers":[<xsl:for-each select="interpreti/interpret_ref">"<xsl:value-of select="key('performerById', .)/nazev"/>"<xsl:if test="position()!=last()">,</xsl:if></xsl:for-each>]}<xsl:if test="position()!=last()">,</xsl:if></xsl:for-each>],"totalItems":<xsl:value-of select="count(sumakce/akce)"/>,"filtersSupported":["day","venueId","performerId"]}</xsl:template>
</xsl:stylesheet>
