{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "location",
    "dates",
    "tickets",
    "links",
    "contact",
    "taxRate",
    "camping"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "location": {
      "type": "object",
      "required": [
        "street",
        "city",
        "postalCode"
      ],
      "properties": {
        "street": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "postalCode": {
          "type": "string"
        }
      }
    },
    "dates": {
      "type": "array",
      "items": {
        "$ref": "#/defs/day"
      }
    },
    "tickets": {
      "type": "array",
      "items": {
        "$ref": "#/defs/ticket"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/defs/link"
      }
    },
    "contact": {
      "type": "object",
      "required": [
        "email",
        "phone"
      ],
      "properties": {
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        }
      }
    },
    "taxRate": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "camping": {
      "type": "object",
      "required": [
        "personPrice",
        "vatRate",
        "dates",
        "types"
      ],
      "properties": {
        "personPrice": {
          "type": "integer",
          "minimum": 0
        },
        "vatRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "dates": {
          "type": "object",
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "from": {
              "type": "string",
              "format": "date"
            },
            "to": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "price",
              "maxPeople",
              "capacity"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "price": {
                "type": "integer",
                "minimum": 0
              },
              "maxPeople": {
                "type": "integer",
                "minimum": 1
              },
              "capacity": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  },
  "defs": {
    "day": {
      "type": "object",
      "required": [
        "id",
        "name",
        "theme",
        "description",
        "date",
        "startTime",
        "endTime"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "theme": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "startTime": {
          "type": "string"
        },
        "endTime": {
          "type": "string"
        }
      }
    },
    "ticket": {
      "type": "object",
      "required": [
        "id",
        "name",
        "price",
        "currency",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "price": {
          "type": "integer"
        },
        "currency": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "link": {
      "type": "object",
      "required": [
        "id",
        "name",
        "url"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}
