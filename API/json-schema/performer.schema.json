{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "name",
    "performerType",
    "genre",
    "description"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "performerType": {
      "type": "string"
    },
    "genre": {
      "type": "string",
      "enum": [
        "Alternative R&B",
        "Alternative hip-hop",
        "Alternative pop",
        "Alternative pop rock",
        "Alternative rock",
        "Alternative rock / nu metal",
        "Alternative rock / progressive rock",
        "Alternative rock / punk",
        "Bass house",
        "Bass house / UK garage",
        "Bassline / UK garage",
        "Bassline / bass house",
        "Big beat / breakbeat",
        "Big beat / techno",
        "Dance pop",
        "Dance pop / disco",
        "Dance pop / house",
        "Drum and bass / dancefloor",
        "Drum and bass / electronic rock",
        "Drum and bass / jump-up",
        "Drum and bass / jungle",
        "Dubstep / bass house",
        "Folk rock",
        "Gothic rock / post-punk",
        "Hard rock",
        "Hard techno",
        "Heavy metal",
        "Indie rock",
        "Industrial metal",
        "Liquid drum and bass",
        "Melodic rap",
        "Metalcore / alternative metal",
        "Pop rap / R&B",
        "Pop rock",
        "Progressive house",
        "Punk rock",
        "R&B / dance pop",
        "R&B / synthpop",
        "Synthpop",
        "Trap",
        "Trap / gangsta rap",
        "Trap / rap",
        "UK bassline",
        "UK garage",
        "UK garage / speed garage"
      ]
    },
    "description": {
      "type": "string"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "platform",
          "label",
          "url",
          "kind",
          "source"
        ],
        "properties": {
          "platform": {
            "enum": [
              "spotify",
              "youtube"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "kind": {
            "enum": [
              "profile",
              "search"
            ]
          },
          "source": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  }
}
