{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "name",
    "location",
    "capacity",
    "description",
    "ticketing"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "capacity": {
      "type": "integer"
    },
    "description": {
      "type": "string"
    },
    "ticketing": {
      "type": "object",
      "required": [
        "standingCapacity",
        "seats",
        "prices"
      ],
      "properties": {
        "standingCapacity": {
          "type": "integer",
          "minimum": 1
        },
        "seats": {
          "type": "object",
          "properties": {
            "vip": {
              "type": "object",
              "required": [
                "rows",
                "perRow"
              ],
              "properties": {
                "rows": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Z]$"
                  }
                },
                "perRow": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            },
            "regular": {
              "type": "object",
              "required": [
                "rows",
                "perRow"
              ],
              "properties": {
                "rows": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Z]$"
                  }
                },
                "perRow": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "prices": {
          "type": "object",
          "required": [
            "standing"
          ],
          "properties": {
            "vip": {
              "type": "object",
              "required": [
                "day",
                "festival"
              ],
              "properties": {
                "day": {
                  "type": "integer",
                  "minimum": 1
                },
                "festival": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            },
            "regular": {
              "type": "object",
              "required": [
                "day",
                "festival"
              ],
              "properties": {
                "day": {
                  "type": "integer",
                  "minimum": 1
                },
                "festival": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            },
            "standing": {
              "type": "object",
              "required": [
                "day",
                "festival"
              ],
              "properties": {
                "day": {
                  "type": "integer",
                  "minimum": 1
                },
                "festival": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
