{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "items",
    "totalItems",
    "filtersSupported"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/defs/event"
      }
    },
    "totalItems": {
      "type": "integer"
    },
    "filtersSupported": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "defs": {
    "event": {
      "type": "object",
      "required": [
        "id",
        "name",
        "theme",
        "description",
        "date",
        "startTime",
        "endTime",
        "dayId",
        "venueId",
        "venueName",
        "performerIds",
        "performers"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "theme": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "startTime": {
          "type": "string"
        },
        "endTime": {
          "type": "string"
        },
        "dayId": {
          "type": "string"
        },
        "venueId": {
          "type": "string"
        },
        "venueName": {
          "type": "string"
        },
        "performerIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "performers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}