{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "items",
    "totalItems"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/defs/venue"
      }
    },
    "totalItems": {
      "type": "integer"
    }
  },
  "defs": {
    "venue": {
      "type": "object",
      "required": [
        "id",
        "name",
        "location",
        "capacity",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "capacity": {
          "type": "integer"
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}