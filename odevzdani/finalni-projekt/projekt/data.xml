<festival xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="ppf2027" lang="cs" xsi:noNamespaceSchemaLocation="festival.xsd">
  <nazev>Prague Pulse Fest</nazev>
  <mistokonani>
    <ulice>Výstaviště 67</ulice>
    <mesto>Praha</mesto>
    <psc>170 00</psc>
  </mistokonani>
  <popis_festivalu>Prague Pulse Fest je fiktivní třídenní městský hudební festival v Praze. Tři scény propojují rock, pop, jazz, elektroniku a další žánry.</popis_festivalu>
  <dny>
    <den id="d1">
      <nazev>Den 1</nazev>
      <tema_dne>Opening Night</tema_dne>
      <popis>Tři scény otevírají festival rockovými koncerty, popem a večerní elektronikou.</popis>
      <datumstart>2027-08-01</datumstart>
      <casstart>09:00:00</casstart>
      <caskonec>23:59:00</caskonec>
    </den>
    <den id="d2">
      <nazev>Den 2</nazev>
      <tema_dne>Main Stage Highlights</tema_dne>
      <popis>Největší festivalový den: od ranních objevů až po hlavní večerní koncerty.</popis>
      <datumstart>2027-08-02</datumstart>
      <casstart>09:00:00</casstart>
      <caskonec>23:59:00</caskonec>
    </den>
    <den id="d3">
      <nazev>Den 3</nazev>
      <tema_dne>Finale &amp; Afterparty</tema_dne>
      <popis>Závěrečné koncerty a klubová afterparty zakončí tři dny pražské hudby.</popis>
      <datumstart>2027-08-03</datumstart>
      <casstart>09:00:00</casstart>
      <caskonec>23:59:00</caskonec>
    </den>
  </dny>
